---
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import bodyFont from '@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/services". Defaults to the current path. */
  path?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props;
const cleanPath = (path ?? Astro.url.pathname).replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath === '/' ? '/' : cleanPath, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  name: site.legalName,
  alternateName: site.name,
  url: site.url,
  logo: `${site.url}/logo.svg`,
  image: ogImage,
  description: site.description,
  email: site.contact.email,
  telephone: site.contact.phoneHref.replace('tel:', ''),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.city,
    addressRegion: site.location.regionCode,
    addressCountry: site.location.country,
  },
  areaServed: { '@type': 'Country', name: site.location.areaServed },
  founder: { '@id': `${site.url}/#founder` },
  knowsAbout: ['AI agents', 'Workflow automation', 'LLM integration', 'n8n'],
  sameAs: Object.values(site.social).filter(Boolean),
};
const founder = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#founder`,
  name: site.founder.name,
  jobTitle: site.founder.title,
  worksFor: { '@id': `${site.url}/#business` },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'New Jersey Institute of Technology' },
  url: `${site.url}/about`,
  sameAs: Object.values(site.social).filter(Boolean),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  publisher: { '@id': `${site.url}/#business` },
};
const schemas = [business, founder, website, ...jsonLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#05081A" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Solo Spark: AI agents and automations for small and mid-sized ops teams" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!--
      Scroll reveals. Inline so it runs before first paint: the "js" class and the
      observer arrive together, so content is never left hidden if scripts fail.
      [data-reveal] fades and rises into view (stagger with style="--i: n").
      [data-inview] only gets the "is-in" class, for CSS-driven effects.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function start() {
          var els = document.querySelectorAll('[data-reveal],[data-inview]');
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('is-in'); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              io.unobserve(el);
              if (el.hasAttribute('data-reveal') && el.animate) {
                var i = parseFloat(getComputedStyle(el).getPropertyValue('--i')) || 0;
                el.animate(
                  [{ opacity: 0, translate: '0 24px' }, { opacity: 1, translate: '0 0' }],
                  { duration: 950, delay: i * 90, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' }
                );
              }
              el.classList.add('is-in');
            });
          }, { rootMargin: '0px 0px -10% 0px' });
          els.forEach(function (el) { io.observe(el); });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
        else start();
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only z-50 rounded-pill bg-snow px-5 py-3 font-bold text-night focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>

    <!-- Ambient light behind the header and first section -->
    <div class="sky" aria-hidden="true">
      <div class="sky-beam"></div>
      <div class="sky-grid"></div>
      <div class="glow glow-cobalt drift-a absolute -top-[26rem] left-[58%] h-[50rem] w-[min(84rem,150vw)] -translate-x-1/2"></div>
      <div class="glow glow-deep drift-b absolute -top-48 -left-72 h-[38rem] w-[54rem]"></div>
    </div>

    <Header />
    <main id="main" class="flex-1 overflow-x-clip">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Cursor-following light on [data-spotlight] cards and panels (mouse only).
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let frame = 0;
    let target: HTMLElement | null = null;
    let x = 0;
    let y = 0;
    const paint = () => {
      frame = 0;
      if (!target) return;
      const r = target.getBoundingClientRect();
      target.style.setProperty('--mx', `${x - r.left}px`);
      target.style.setProperty('--my', `${y - r.top}px`);
    };
    document.addEventListener(
      'pointermove',
      (e) => {
        const el = (e.target as Element | null)?.closest<HTMLElement>('[data-spotlight]');
        if (!el) return;
        target = el;
        x = e.clientX;
        y = e.clientY;
        if (!frame) frame = requestAnimationFrame(paint);
      },
      { passive: true },
    );
  }
</script>
