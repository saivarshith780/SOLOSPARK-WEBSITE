---
import Base from '../layouts/Base.astro';
import SparkOrb from '../components/SparkOrb.astro';
import HeroOrbit from '../components/HeroOrbit.astro';
import { nav } from '../config/site';
---
<Base
  title="Page Not Found (404) | Solo Spark"
  description="This page doesn't exist on mysolospark.com. Head back to the home page or pick a section below."
  path="/404"
  noindex
>
  <section class="section-y">
    <div class="page-x grid items-center gap-x-[clamp(2rem,5vw,6rem)] lg:min-h-[min(60svh,40rem)] lg:grid-cols-[1.5fr_1fr]">
      <div>
      <div class="load-in flex items-center gap-4">
        <SparkOrb class="h-12 w-12" />
        <p class="font-display text-step-1 font-bold text-volt">Error 404</p>
      </div>
      <h1 class="type-display text-lit load-in mt-8 max-w-[14ch]" style="--d:100ms">This wire doesn't connect to anything.</h1>
      <p class="lede load-in mt-7" style="--d:180ms">The page you're looking for isn't here. It may have moved, or the link may be mistyped.</p>
      <div class="load-in mt-10 flex flex-wrap gap-4" style="--d:260ms">
        <a class="btn btn-light" href="/">Go to the home page</a>
      </div>
      <nav aria-label="Site sections" class="load-in mt-12" style="--d:340ms">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {nav.map((n) => <li><a class="link" href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      </div>
      <div class="load-in hidden justify-end lg:flex" style="--d:200ms">
        <HeroOrbit />
      </div>
    </div>
  </section>
</Base>
