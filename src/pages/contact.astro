---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import BookButton from '../components/BookButton.astro';
import EmailLink from '../components/EmailLink.astro';
import { site, bookingIsExternal } from '../config/site';
---
<Base
  title="Contact Solo Spark | Book a Free 15-Minute Automation Call"
  description="Tell me what you want to automate. Send a message, book a free 15-minute intro call, or email or call Sai Varshith Chinthalapally at Solo Spark directly."
>
  <PageHero
    title="Tell me what you'd like off your plate"
    lede="Send a short note about the work your team does by hand. I read every message myself."
  />

  <section class="section-y seam relative" aria-labelledby="form-heading">
    <div class="glow glow-cobalt absolute top-1/3 left-[30%] h-[40rem] w-[56rem] -translate-x-1/2 opacity-50" aria-hidden="true"></div>
    <div class="page-x relative grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
      <div class="panel p-6 sm:p-9 lg:p-11" data-reveal>
        <h2 id="form-heading" class="type-section text-lit mb-8 text-step-3!">Send a message</h2>
        <ContactForm />
      </div>

      <aside class="space-y-6" aria-label="Other ways to reach me" data-reveal style="--i:1">
        {bookingIsExternal && (
          <div class="booking panel overflow-hidden p-7">
            <div class="glow glow-spark absolute -right-24 -bottom-24 -z-10 h-72 w-72" aria-hidden="true"></div>
            <h2 class="text-step-2">Rather talk?</h2>
            <p class="mt-3 text-mist">Book a free {site.call.length} intro call at a time that suits you.</p>
            <BookButton class="mt-6" />
          </div>
        )}
        <div class="panel p-7" data-spotlight>
          <div class="reach">
            <h2 class="font-display text-step-1">Email</h2>
            <p class="mt-2"><EmailLink /></p>
          </div>
          <div class="reach">
            <h2 class="font-display text-step-1">Phone</h2>
            <a class="link mt-2 inline-block" href={site.contact.phoneHref}>{site.contact.phone}</a>
          </div>
          <div class="reach">
            <h2 class="font-display text-step-1">Where I work</h2>
            <p class="mt-2 text-mist">
              Based in {site.location.city}, {site.location.region}. Fully remote, with clients across the US.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .reach + .reach {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
</style>
