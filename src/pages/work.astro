---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { builds } from '../config/site';
---
<Base
  title="AI Automation Case Studies: Phone Agent & n8n | Solo Spark"
  description="Two systems I built: an AI phone-ordering agent for a restaurant (Twilio, n8n, Claude) and an n8n pipeline that researches, scores, personalizes and sends."
>
  <PageHero
    title="AI automations I've built"
    lede="Two real builds, described plainly: the problem, what I built, how it works, and the tools behind it."
  />

  {builds.map((b, i) => (
    <article
      id={b.slug}
      class:list={['section-y scroll-mt-4 border-b border-line', i % 2 === 1 && 'bg-white']}
      aria-labelledby={`${b.slug}-heading`}
    >
      <div class="page-x">
        <p class="inline-block rounded-sm bg-ink px-3 py-1 text-step--1 font-bold text-white">{b.status}</p>
        <h2 id={`${b.slug}-heading`} class="type-section mt-5 max-w-[22ch]">{b.name}</h2>
        <p class="lede mt-5 text-slate">{b.summary}</p>

        <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
          <div class="space-y-10">
            <section>
              <h3 class="text-step-2">The problem</h3>
              <p class="mt-3">{b.problem}</p>
            </section>
            <section>
              <h3 class="text-step-2">What I built</h3>
              <p class="mt-3">{b.built}</p>
            </section>
            {b.note && (
              <p class="border-l-4 border-spark pl-4 text-slate">{b.note}</p>
            )}
          </div>

          <div class="space-y-10">
            <section>
              <h3 class="text-step-2">How it works</h3>
              <ol class="flow mt-5 space-y-5">
                {b.how.map((step, n) => (
                  <li class="relative pl-12">
                    <span class="absolute top-0 left-0 inline-flex h-8 w-8 items-center justify-center rounded-full bg-cobalt font-display font-bold text-white">{n + 1}</span>
                    {step}
                  </li>
                ))}
              </ol>
            </section>
            <section>
              <h3 class="text-step-2">The stack</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {b.stack.map((t) => <li class="chip">{t}</li>)}
              </ul>
            </section>
            {b.alsoFits && (
              <section>
                <h3 class="text-step-2">The same pattern fits</h3>
                <p class="mt-3 text-slate">Research, score, personalize, send. Swap the inputs and it works for:</p>
                <ul class="mt-4 space-y-3">
                  {b.alsoFits.map((f) => (
                    <li class="flex gap-3">
                      <span class="mt-2.5 h-2 w-2 flex-none rounded-full bg-cobalt" aria-hidden="true"></span>
                      {f}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>
      </div>
    </article>
  ))}

  <CtaBand heading="Have a process like one of these?" />
</Base>

<style>
  .flow li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 2.25rem;
    bottom: -1rem;
    width: 2px;
    background: var(--color-line);
  }
</style>
