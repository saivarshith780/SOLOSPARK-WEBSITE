---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import Steps from '../components/Steps.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Spark from '../components/Spark.astro';
import SparkOrb from '../components/SparkOrb.astro';
import ServiceGlyph from '../components/ServiceGlyph.astro';
import { site, services, builds, tools, faq } from '../config/site';

const chores = [
  'Retyping form entries into the CRM',
  'Sorting the support inbox by hand',
  'Building the same report every Monday',
  'Chasing customers to confirm appointments',
  'Missing calls when everyone is busy',
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Solo Spark | AI Agents & Workflow Automation for Ops Teams"
  description="I build AI agents, n8n workflow automations and LLM integrations that take repetitive work off small and mid-sized ops teams. Book a free 15-minute call."
  path="/"
  jsonLd={[faqLd]}
>
  <!-- Hero: the one orchestrated moment. Copy rises in, then the circuit lights up. -->
  <section class="relative" aria-labelledby="hero-heading">
    <div class="page-x screen-fill items-center gap-x-[clamp(2rem,5vw,6rem)] gap-y-14 py-10 md:py-14 lg:grid-cols-[1.05fr_1fr]">
      <div>
        <h1 id="hero-heading" class="type-display text-lit load-in max-w-[12ch]">Get your team out of copy&#8209;paste.</h1>
        <p class="lede load-in mt-7" style="--d:120ms">
          I build AI agents and automations for small and mid-sized ops teams. They take over the data entry,
          sorting and follow-ups that fill your week, so your people get hours back and fewer things slip.
        </p>
        <div class="load-in mt-10 flex flex-wrap items-center gap-3" style="--d:220ms">
          <BookButton />
          <a href="/work" class="btn btn-ghost">See what I've built</a>
        </div>
        <p class="load-in mt-6 flex items-center gap-2.5 text-step--1 text-haze" style="--d:320ms">
          <Spark class="h-3.5 w-3.5 flex-none" />
          Free {site.call.length} intro. You talk to the engineer who builds it.
        </p>
      </div>
      <div class="load-in flex justify-center lg:justify-end" style="--d:180ms">
        <HeroDiagram />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section-y seam relative" aria-labelledby="problem-heading">
    <div class="glow glow-deep absolute top-1/2 right-[-8%] h-[38rem] w-[min(52rem,120vw)] -translate-y-1/2 opacity-80" aria-hidden="true"></div>
    <div class="page-x relative grid gap-12 md:grid-cols-2 md:items-center md:gap-16">
      <div data-reveal>
        <h2 id="problem-heading" class="type-section text-lit max-w-[16ch]">Your team is busy doing work a computer could do.</h2>
        <p class="mt-6 max-w-[34rem] text-mist">
          Most of these jobs follow the same steps every time. They still take hours each week, and every
          manual handoff is a chance to type something wrong or let a lead go cold.
        </p>
      </div>
      <ul class="chores panel p-2 sm:p-2.5" data-reveal style="--i:1">
        {chores.map((c) => (
          <li class="chore flex items-center gap-4 rounded-tile px-4 py-4 text-step-1 sm:px-5">
            <span class="chore-dot h-2 w-2 flex-none rounded-full" aria-hidden="true"></span>
            {c}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="section-y seam relative" aria-labelledby="services-heading">
    <div class="glow glow-cobalt absolute top-[58%] left-1/2 h-[36rem] w-[min(76rem,150vw)] -translate-x-1/2 -translate-y-1/2 opacity-60" aria-hidden="true"></div>
    <div class="page-x relative">
      <h2 id="services-heading" class="type-section text-lit max-w-[18ch]" data-reveal>Three ways I take work off your plate</h2>
      <div class="console panel mt-12 grid lg:grid-cols-3" data-spotlight data-reveal style="--i:1">
        {services.map((s) => (
          <article class="console-cell flex flex-col p-7 md:p-9">
            <ServiceGlyph slug={s.slug} />
            <h3 class="mt-7 text-step-2">{s.name}</h3>
            <p class="mt-3 max-w-[34rem] text-mist">{s.short}</p>
            <p class="mt-6 flex items-start gap-2.5 font-bold text-snow">
              <Spark class="mt-1.5 h-3.5 w-3.5 flex-none" />
              {s.outcome}
            </p>
            <a class="link mt-auto inline-block self-start pt-7" href={`/services#${s.slug}`}>
              See use cases<span class="sr-only"> for {s.name}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-y seam relative" aria-labelledby="how-heading">
    <!-- Light given off by the wire between the steps -->
    <div class="glow glow-cobalt absolute bottom-[12%] left-1/2 h-[22rem] w-[min(80rem,160vw)] -translate-x-1/2 opacity-45" aria-hidden="true"></div>
    <div class="page-x relative">
      <div data-reveal>
        <h2 id="how-heading" class="type-section text-lit">How a project runs</h2>
        <p class="mt-4 max-w-[34rem] text-mist">One process at a time. You see it working before we move to the next.</p>
      </div>
      <div class="mt-14"><Steps /></div>
    </div>
  </section>

  <!-- Featured builds -->
  <section class="section-y seam relative" aria-labelledby="work-heading">
    <div class="glow glow-deep absolute top-1/3 -left-48 h-[34rem] w-[46rem] opacity-70" aria-hidden="true"></div>
    <div class="page-x relative">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 id="work-heading" class="type-section text-lit">Things I've built</h2>
        <a class="link" href="/work">Read the full write-ups</a>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {builds.map((b, i) => (
          <div class="h-full" data-reveal style={`--i:${i}`}>
            <article class:list={['card flex h-full flex-col overflow-hidden p-7 md:p-10', i === 0 && 'build-featured']} data-spotlight>
              {i === 0 && <div class="glow glow-cobalt absolute -top-56 -right-40 -z-10 h-[30rem] w-[36rem] opacity-80" aria-hidden="true"></div>}
              <p class:list={['tag self-start', i === 0 && 'tag-spark']}>{b.status}</p>
              <h3 class="mt-6 text-step-2">{b.name}</h3>
              <p class="mt-4 text-mist">{b.summary}</p>
              <ul class="mt-7 flex flex-wrap gap-2" aria-label="Built with">
                {b.stack.map((t) => <li class="chip">{t}</li>)}
              </ul>
              <a class="link mt-auto inline-block self-start pt-9" href={`/work#${b.slug}`}>
                How it works<span class="sr-only">: {b.name}</span>
              </a>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="seam relative" aria-labelledby="tools-heading">
    <div class="page-x flex flex-col gap-5 py-12 md:flex-row md:items-center md:gap-10" data-reveal>
      <h2 id="tools-heading" class="flex-none font-display text-step-1">What I build with</h2>
      <ul class="flex flex-wrap gap-2">
        {tools.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section class="section-y seam relative" aria-labelledby="founder-heading">
    <div class="page-x grid gap-10 md:grid-cols-[auto_1fr] md:items-start md:gap-16">
      <div data-reveal>
        <SparkOrb class="h-28 w-28 md:h-40 md:w-40" />
      </div>
      <div class="max-w-[40rem]" data-reveal style="--i:1">
        <h2 id="founder-heading" class="type-section text-lit">You work with me, start to finish.</h2>
        <p class="mt-6 text-step-1">
          I'm {site.founder.name}, founder of Solo Spark. I'm an AI automation engineer who specializes in n8n,
          with an {site.founder.education}.
        </p>
        <p class="mt-4 text-mist">
          There's no sales team or account manager in between. The person on your intro call is the person who maps
          your process, builds the system and answers when you have a question. I'm based in{' '}
          {site.location.city}, {site.location.region}, and work remotely with teams across the US.
        </p>
        <a class="link mt-7 inline-block" href="/about">More about me</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-y seam relative" aria-labelledby="faq-heading">
    <div class="glow glow-deep absolute top-[20%] right-[-10%] h-[34rem] w-[min(48rem,120vw)] opacity-60" aria-hidden="true"></div>
    <div class="page-x relative grid gap-10 md:grid-cols-[1fr_1.6fr] md:gap-16">
      <h2 id="faq-heading" class="type-section text-lit md:sticky md:top-[calc(var(--header-h)+2rem)] md:self-start" data-reveal>Questions people ask first</h2>
      <div data-reveal style="--i:1">
        <FaqList items={faq} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Each chore is a manual job; its light comes on as you point at it */
  .chore {
    position: relative;
    transition: background-color 300ms;
  }
  .chore + .chore::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1rem;
    right: 1rem;
    height: 1px;
    background: var(--color-line);
  }
  .chore-dot {
    background: var(--color-haze);
    transition:
      background-color 300ms,
      box-shadow 300ms;
  }
  @media (hover: hover) {
    .chore:hover {
      background: rgb(255 255 255 / 0.04);
    }
    .chore:hover .chore-dot {
      background: var(--color-spark);
      box-shadow: 0 0 12px rgb(255 201 51 / 0.9);
    }
  }

  /* Three services in one console, separated by hairlines */
  .console-cell + .console-cell {
    box-shadow: 0 -1px 0 var(--color-line);
  }
  @media (min-width: 64rem) {
    .console-cell + .console-cell {
      box-shadow: -1px 0 0 var(--color-line);
    }
  }

  .build-featured {
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(27 54 201 / 0.35), transparent 70%),
      linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.02) 65%);
  }
</style>
