---
import Base from '../layouts/Base.astro';
import BookButton from '../components/BookButton.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import Steps from '../components/Steps.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import Spark from '../components/Spark.astro';
import { site, services, builds, tools, faq } from '../config/site';

const chores = [
  'Retyping form entries into the CRM',
  'Sorting the support inbox by hand',
  'Building the same report every Monday',
  'Chasing customers to confirm appointments',
  'Missing calls when everyone is busy',
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base
  title="Solo Spark | AI Agents & Workflow Automation for Ops Teams"
  description="I build AI agents, n8n workflow automations and LLM integrations that take repetitive work off small and mid-sized ops teams. Book a free 15-minute call."
  path="/"
  jsonLd={[faqLd]}
>
  <!-- Hero -->
  <section class="on-dark relative overflow-hidden bg-cobalt text-white">
    <div class="page-x grid items-center gap-12 pt-14 pb-16 md:pt-20 md:pb-24 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <h1 class="type-display max-w-[13ch]">Get your team out of copy&#8209;paste.</h1>
        <p class="lede mt-6 text-mist">
          I build AI agents and automations for small and mid-sized ops teams. They take over the data entry,
          sorting and follow-ups that fill your week, so your people get hours back and fewer things slip.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <BookButton />
          <a href="/work" class="btn btn-ghost">See what I've built</a>
        </div>
        <p class="mt-5 text-step--1 text-mist">
          Free {site.call.length} intro. You talk to the engineer who builds it.
        </p>
      </div>
      <div class="flex justify-center lg:justify-end">
        <HeroDiagram />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section-y" aria-labelledby="problem-heading">
    <div class="page-x grid gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <h2 id="problem-heading" class="type-section max-w-[16ch]">Your team is busy doing work a computer could do.</h2>
        <p class="mt-6 max-w-[34rem] text-slate">
          Most of these jobs follow the same steps every time. They still take hours each week, and every
          manual handoff is a chance to type something wrong or let a lead go cold.
        </p>
      </div>
      <ul class="self-end border-t-2 border-ink">
        {chores.map((c) => (
          <li class="flex items-center gap-4 border-b border-line py-4 text-step-1">
            <span class="h-2.5 w-2.5 flex-none rounded-full bg-cobalt" aria-hidden="true"></span>
            {c}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="section-y border-t border-line bg-white" aria-labelledby="services-heading">
    <div class="page-x">
      <h2 id="services-heading" class="type-section max-w-[18ch]">Three ways I take work off your plate</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0 md:divide-x md:divide-line">
        {services.map((s) => (
          <article class="md:px-8 md:first:pl-0 md:last:pr-0">
            <h3 class="type-card text-step-2">{s.name}</h3>
            <p class="mt-3 text-slate">{s.short}</p>
            <p class="mt-4 font-bold">{s.outcome}</p>
            <a class="link mt-5 inline-block" href={`/services#${s.slug}`}>
              See use cases<span class="sr-only"> for {s.name}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section-y border-t border-line" aria-labelledby="how-heading">
    <div class="page-x">
      <h2 id="how-heading" class="type-section">How a project runs</h2>
      <p class="mt-4 max-w-[34rem] text-slate">One process at a time. You see it working before we move to the next.</p>
      <div class="mt-12"><Steps /></div>
    </div>
  </section>

  <!-- Featured builds -->
  <section class="section-y border-t border-line bg-white" aria-labelledby="work-heading">
    <div class="page-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="work-heading" class="type-section">Things I've built</h2>
        <a class="link" href="/work">Read the full write-ups</a>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {builds.map((b, i) => (
          <article class:list={['flex flex-col rounded-sm p-7 md:p-9', i === 0 ? 'on-dark bg-ink text-white' : 'border-2 border-ink']}>
            <p class:list={['text-step--1 font-bold', i === 0 ? 'text-spark' : 'text-cobalt']}>{b.status}</p>
            <h3 class="mt-3 text-step-2">{b.name}</h3>
            <p class:list={['mt-4', i === 0 ? 'text-mist' : 'text-slate']}>{b.summary}</p>
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Built with">
              {b.stack.map((t) => (
                <li class:list={['chip', i === 0 && 'border-white/25! bg-transparent! text-white']}>{t}</li>
              ))}
            </ul>
            <a class="link mt-auto inline-block pt-8" href={`/work#${b.slug}`}>
              How it works<span class="sr-only">: {b.name}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="border-t border-line" aria-labelledby="tools-heading">
    <div class="page-x flex flex-col gap-5 py-10 md:flex-row md:items-center md:gap-10">
      <h2 id="tools-heading" class="flex-none font-display text-step-1">What I build with</h2>
      <ul class="flex flex-wrap gap-2">
        {tools.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section class="section-y border-t border-line bg-white" aria-labelledby="founder-heading">
    <div class="page-x grid gap-10 md:grid-cols-[auto_1fr] md:items-start md:gap-14">
      <div class="relative flex h-28 w-28 items-center justify-center rounded-full bg-cobalt md:h-36 md:w-36" aria-hidden="true">
        <Spark class="h-14 w-14 md:h-18 md:w-18" />
      </div>
      <div class="max-w-[40rem]">
        <h2 id="founder-heading" class="type-section">You work with me, start to finish.</h2>
        <p class="mt-6 text-step-1">
          I'm {site.founder.name}, founder of Solo Spark. I'm an AI automation engineer who specializes in n8n,
          with an {site.founder.education}.
        </p>
        <p class="mt-4 text-slate">
          There's no sales team or account manager in between. The person on your intro call is the person who maps
          your process, builds the system and answers when you have a question. I'm based in{' '}
          {site.location.city}, {site.location.region}, and work remotely with teams across the US.
        </p>
        <a class="link mt-6 inline-block" href="/about">More about me</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-y border-t border-line" aria-labelledby="faq-heading">
    <div class="page-x grid gap-10 md:grid-cols-[1fr_1.6fr] md:gap-16">
      <h2 id="faq-heading" class="type-section">Questions people ask first</h2>
      <FaqList items={faq} />
    </div>
  </section>

  <CtaBand />
</Base>
