---
// A small workflow graph: a request comes in, the agent handles it, work lands
// where it belongs. One spark travels the wire (static under reduced motion).
import { sparkPath } from '../lib/logo';
const wire = 'M112 92 V150 Q112 170 132 170 H230 Q250 170 250 190 V258 Q250 278 270 278 H330 Q350 278 350 298 V318';
---
<figure class="hero-diagram relative w-full max-w-[30rem]" aria-labelledby="diagram-caption">
  <svg viewBox="0 0 460 400" class="w-full overflow-visible" role="img" aria-labelledby="diagram-title">
    <title id="diagram-title">A request comes in, an AI agent handles it, and the result lands in your tools. Unusual cases go to a person.</title>
    <g fill="none" stroke="var(--color-mist)" stroke-width="2.5" stroke-linecap="round" opacity="0.7">
      <path d={wire}></path>
      <path d="M250 258 Q250 278 230 278 H132 Q112 278 112 298 V318"></path>
    </g>

    <g font-family="var(--font-sans)" font-size="18">
      <rect x="0" y="30" width="250" height="62" rx="10" fill="var(--color-white)"></rect>
      <text x="18" y="67" fill="var(--color-ink)" font-weight="700">New form, email or call</text>

      <rect x="130" y="190" width="240" height="48" rx="24" fill="var(--color-ink)"></rect>
      <path transform="translate(148 202)" fill="var(--color-spark)" d={sparkPath}></path>
      <text x="182" y="220" fill="var(--color-white)" font-weight="700">AI agent handles it</text>

      <rect x="0" y="318" width="230" height="62" rx="10" fill="var(--color-white)" fill-opacity="0.12" stroke="var(--color-mist)" stroke-width="1.5"></rect>
      <text x="18" y="355" fill="var(--color-white)">Odd ones go to a person</text>

      <rect x="244" y="318" width="216" height="62" rx="10" fill="var(--color-white)"></rect>
      <text x="262" y="355" fill="var(--color-ink)" font-weight="700">Logged in your tools</text>
    </g>

    <g class="traveller" style={`offset-path: path('${wire}');`}>
      <circle r="11" fill="var(--color-spark)" opacity="0.3"></circle>
      <circle r="5" fill="var(--color-spark)"></circle>
    </g>
  </svg>
  <figcaption id="diagram-caption" class="sr-only">How an automation I build handles a routine request.</figcaption>
</figure>

<style>
  .traveller {
    offset-rotate: 0deg;
    offset-distance: 100%;
    animation: travel 2.6s cubic-bezier(0.45, 0, 0.25, 1) 0.6s 1 both;
  }
  @keyframes travel {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .traveller {
      animation: none;
    }
  }
</style>
