---
// A small workflow circuit: a request comes in, the agent handles it, and the
// work lands where it belongs. On load the wires draw in, then a spark travels
// the wire on a loop: it passes through the agent (which glows) and lights up
// the tools it lands in. Unusual cases branch off to a person (dashed wire).
// Under reduced motion it is a still picture with the destination lit.
import { sparkPath } from '../lib/logo';
const wire = 'M112 92 V150 Q112 170 132 170 H230 Q250 170 250 190 V258 Q250 278 270 278 H330 Q350 278 350 298 V318';
const branch = 'M250 258 Q250 278 230 278 H132 Q112 278 112 298 V318';
// Phones get a taller, narrower layout of the same circuit so the labels stay
// readable (about 15px on a 320px screen instead of under 10px).
const wireC = 'M150 58 V174 Q150 184 160 184 H219 Q229 184 229 194 V214';
const branchC = 'M150 174 Q150 184 140 184 H81 Q71 184 71 194 V214';
---
<figure class="hero-diagram relative w-full max-w-[min(34rem,100%)]" aria-labelledby="diagram-caption">
  <!-- Light cast by the circuit onto the page behind it -->
  <div class="glow glow-cobalt absolute -inset-x-16 -inset-y-20 opacity-90" aria-hidden="true"></div>
  <div class="glow glow-spark agent-light absolute top-[38%] left-[22%] h-[55%] w-[60%]" aria-hidden="true"></div>

  <div class="diagram-panel panel float p-3 sm:p-6 lg:p-7">
    <svg viewBox="-6 22 472 366" class="hd-wide hidden w-full overflow-visible sm:block" role="img" aria-labelledby="diagram-title">
      <title id="diagram-title">A request comes in, an AI agent handles it, and the result lands in your tools. Unusual cases go to a person.</title>
      <defs>
        <linearGradient id="hd-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.12"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.035"></stop>
        </linearGradient>
        <linearGradient id="hd-edge" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#dbe2ff" stop-opacity="0.55"></stop>
          <stop offset="1" stop-color="#dbe2ff" stop-opacity="0.1"></stop>
        </linearGradient>
        <linearGradient id="hd-agent" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#22307f"></stop>
          <stop offset="1" stop-color="#0c1340"></stop>
        </linearGradient>
        <radialGradient id="hd-halo">
          <stop offset="0" stop-color="#ffc933" stop-opacity="0.6"></stop>
          <stop offset="0.4" stop-color="#ffc933" stop-opacity="0.18"></stop>
          <stop offset="1" stop-color="#ffc933" stop-opacity="0"></stop>
        </radialGradient>
        <filter id="hd-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <!-- Wires -->
      <path class="wire" d={wire} pathLength="100"></path>
      <path class="wire-branch" d={branch}></path>

      <!-- The spark and its trail run under the nodes, so it disappears into the agent -->
      <path class="trail" d={wire} pathLength="100" filter="url(#hd-glow)"></path>
      <g class="traveller" style={`offset-path: path('${wire}');`}>
        <circle r="15" fill="url(#hd-halo)"></circle>
        <circle r="4.5" fill="#fff6d6"></circle>
        <circle r="4.5" fill="none" stroke="#ffc933" stroke-width="1.6"></circle>
      </g>

      <!-- Nodes -->
      <g class="node node-in">
        <rect x="0" y="30" width="250" height="62" rx="14" class="node-box"></rect>
        <text x="18" y="67" class="node-label">New form, email or call</text>
      </g>

      <g class="node node-agent">
        <circle cx="250" cy="214" r="74" fill="url(#hd-halo)" class="agent-halo"></circle>
        <rect x="130" y="190" width="240" height="48" rx="24" fill="url(#hd-agent)" class="agent-box"></rect>
        <path transform="translate(148 202)" d={sparkPath} class="agent-spark"></path>
        <text x="182" y="220" class="node-label">AI agent handles it</text>
      </g>

      <g class="node node-person">
        <rect x="0" y="318" width="230" height="62" rx="14" class="node-box node-box-quiet"></rect>
        <text x="18" y="355" class="node-label node-label-quiet">Odd ones go to a person</text>
      </g>

      <g class="node node-tools">
        <rect x="244" y="318" width="216" height="62" rx="14" class="node-box"></rect>
        <rect x="244" y="318" width="216" height="62" rx="14" class="tools-lit" filter="url(#hd-glow)"></rect>
        <text x="262" y="355" class="node-label">Logged in your tools</text>
      </g>
    </svg>

    <!-- Phone layout. Gradients and filters are its own: a paint server inside
         the hidden wide SVG would not render. -->
    <svg viewBox="-6 -6 312 302" class="hd-compact block w-full overflow-visible sm:hidden" role="img" aria-labelledby="diagram-title-c">
      <title id="diagram-title-c">A request comes in, an AI agent handles it, and the result lands in your tools. Unusual cases go to a person.</title>
      <defs>
        <linearGradient id="hc-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffffff" stop-opacity="0.12"></stop>
          <stop offset="1" stop-color="#ffffff" stop-opacity="0.035"></stop>
        </linearGradient>
        <linearGradient id="hc-edge" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#dbe2ff" stop-opacity="0.55"></stop>
          <stop offset="1" stop-color="#dbe2ff" stop-opacity="0.1"></stop>
        </linearGradient>
        <linearGradient id="hc-agent" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#22307f"></stop>
          <stop offset="1" stop-color="#0c1340"></stop>
        </linearGradient>
        <radialGradient id="hc-halo">
          <stop offset="0" stop-color="#ffc933" stop-opacity="0.6"></stop>
          <stop offset="0.4" stop-color="#ffc933" stop-opacity="0.18"></stop>
          <stop offset="1" stop-color="#ffc933" stop-opacity="0"></stop>
        </radialGradient>
        <filter id="hc-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <path class="wire" d={wireC} pathLength="100"></path>
      <path class="wire-branch" d={branchC}></path>
      <path class="trail" d={wireC} pathLength="100" filter="url(#hc-glow)"></path>
      <g class="traveller" style={`offset-path: path('${wireC}');`}>
        <circle r="15" fill="url(#hc-halo)"></circle>
        <circle r="4.5" fill="#fff6d6"></circle>
        <circle r="4.5" fill="none" stroke="#ffc933" stroke-width="1.6"></circle>
      </g>

      <g class="node node-in">
        <rect x="0" y="0" width="300" height="58" rx="14" class="node-box"></rect>
        <text x="18" y="35" class="node-label">New form, email or call</text>
      </g>

      <g class="node node-agent">
        <circle cx="150" cy="129" r="64" fill="url(#hc-halo)" class="agent-halo"></circle>
        <rect x="30" y="104" width="240" height="50" rx="25" fill="url(#hc-agent)" class="agent-box"></rect>
        <path transform="translate(50 117)" d={sparkPath} class="agent-spark"></path>
        <text x="84" y="135" class="node-label">AI agent handles it</text>
      </g>

      <g class="node node-person">
        <rect x="0" y="214" width="142" height="76" rx="14" class="node-box node-box-quiet"></rect>
        <text class="node-label node-label-quiet"><tspan x="16" y="246">Odd ones go</tspan><tspan x="16" y="270">to a person</tspan></text>
      </g>

      <g class="node node-tools">
        <rect x="158" y="214" width="142" height="76" rx="14" class="node-box"></rect>
        <rect x="158" y="214" width="142" height="76" rx="14" class="tools-lit" filter="url(#hc-glow)"></rect>
        <text class="node-label"><tspan x="174" y="246">Logged in</tspan><tspan x="174" y="270">your tools</tspan></text>
      </g>
    </svg>
  </div>
  <figcaption id="diagram-caption" class="sr-only">How an automation I build handles a routine request.</figcaption>
</figure>

<style>
  /* No backdrop blur here on purpose: the panel floats, and re-blurring the
     page behind it every frame would cost more than it shows. */
  .diagram-panel {
    --radius-panel: 1.6rem;
    background: linear-gradient(180deg, rgb(160 175 255 / 0.08), rgb(10 15 42 / 0.55) 70%);
  }

  /* Stacked layouts (phones, tablets): never taller than about half the
     screen, so the whole hero fits on a portrait tablet. */
  @media (max-width: 63.99rem) {
    .hero-diagram {
      max-width: min(34rem, 100%, max(20rem, calc((100svh - var(--header-h)) * 0.5)));
    }
  }
  /* The agent's light sits higher in the phone layout */
  @media (max-width: 39.99rem) {
    .agent-light {
      top: 26%;
      left: 20%;
      width: 60%;
      height: 45%;
    }
  }
  .hd-compact .node-box {
    fill: url(#hc-fill);
    stroke: url(#hc-edge);
  }

  /* ---- Still picture (also the reduced-motion state) ---- */
  .wire {
    fill: none;
    stroke: rgb(180 192 240 / 0.32);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .wire-branch {
    fill: none;
    stroke: rgb(180 192 240 / 0.3);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 7;
  }
  .node-box {
    fill: url(#hd-fill);
    stroke: url(#hd-edge);
    stroke-width: 1.25;
  }
  .node-box-quiet {
    fill: rgb(255 255 255 / 0.025);
    stroke: rgb(180 192 240 / 0.24);
  }
  .node-label {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 700;
    fill: var(--color-snow);
  }
  .node-label-quiet {
    font-weight: 400;
    fill: var(--color-mist);
  }
  .agent-box {
    stroke: rgb(255 201 51 / 0.6);
    stroke-width: 1.25;
  }
  .agent-spark {
    fill: var(--color-spark);
  }
  .agent-halo {
    opacity: 0.55;
  }
  .tools-lit {
    fill: rgb(255 201 51 / 0.06);
    stroke: rgb(255 201 51 / 0.85);
    stroke-width: 1.5;
    opacity: 1;
  }
  .trail {
    fill: none;
    stroke: var(--color-spark);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 16 300;
    stroke-dashoffset: -100;
    opacity: 0;
  }
  .traveller {
    offset-rotate: 0deg;
    offset-distance: 100%;
  }
  .agent-light {
    opacity: 0.8;
  }

  /* ---- Motion ---- */
  @media (prefers-reduced-motion: no-preference) {
    /* Load: the wires draw in, then the nodes arrive in reading order */
    .wire {
      stroke-dasharray: 100;
      animation: hd-draw 1.5s var(--ease-out-quart) 0.6s backwards;
    }
    .wire-branch {
      animation: hd-fade 0.8s ease 1.5s backwards;
    }
    .node {
      transform-box: fill-box;
      transform-origin: center;
      animation: hd-node 1s var(--ease-out-expo) backwards;
    }
    .node-in {
      animation-delay: 0.45s;
    }
    .node-agent {
      animation-delay: 0.85s;
    }
    .node-person {
      animation-delay: 1.2s;
    }
    .node-tools {
      animation-delay: 1.3s;
    }

    /* Loop: one spark every 6.5s. Every piece shares the same clock. */
    .traveller,
    .trail,
    .agent-halo,
    .tools-lit,
    .agent-light {
      animation-duration: 6.5s;
      animation-delay: 2.1s;
      animation-iteration-count: infinite;
      animation-timing-function: linear;
      animation-fill-mode: both;
    }
    .traveller {
      animation-name: hd-travel;
    }
    .trail {
      animation-name: hd-trail;
    }
    .agent-halo {
      animation-name: hd-agent;
    }
    .agent-light {
      animation-name: hd-agent-light;
    }
    .tools-lit {
      animation-name: hd-tools;
    }
    .hd-compact .agent-halo {
      animation-name: hc-agent;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 39.99rem) {
    .agent-light {
      animation-name: hc-agent-light;
    }
  }
  /* Browsers without motion paths keep the still picture */
  @supports not (offset-path: path('M0 0')) {
    .traveller,
    .trail {
      animation: none !important;
      display: none;
    }
  }

  @keyframes hd-draw {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hd-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes hd-node {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
  }
  /* The spark covers the wire in the first 46% of the loop, at constant speed. */
  @keyframes hd-travel {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    4% {
      opacity: 1;
    }
    46% {
      offset-distance: 100%;
      opacity: 1;
    }
    54%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  /* Dash offset = trail length - spark position, so the trail sticks to the spark */
  @keyframes hd-trail {
    0% {
      stroke-dashoffset: 16;
      opacity: 0;
    }
    4% {
      opacity: 0.85;
    }
    46% {
      stroke-dashoffset: -84;
      opacity: 0.85;
    }
    53%,
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }
  /* The spark is inside the agent between about 23% and 29% of the loop */
  @keyframes hd-agent {
    0%,
    19% {
      opacity: 0.45;
    }
    26% {
      opacity: 1;
    }
    40%,
    100% {
      opacity: 0.45;
    }
  }
  @keyframes hd-agent-light {
    0%,
    19% {
      opacity: 0.55;
    }
    27% {
      opacity: 1;
    }
    42%,
    100% {
      opacity: 0.55;
    }
  }
  /* Phone layout: the spark is inside the agent between about 9% and 20% */
  @keyframes hc-agent {
    0%,
    6% {
      opacity: 0.45;
    }
    14% {
      opacity: 1;
    }
    28%,
    100% {
      opacity: 0.45;
    }
  }
  @keyframes hc-agent-light {
    0%,
    6% {
      opacity: 0.55;
    }
    15% {
      opacity: 1;
    }
    30%,
    100% {
      opacity: 0.55;
    }
  }
  /* ...and lands in your tools at 46% */
  @keyframes hd-tools {
    0%,
    44% {
      opacity: 0;
    }
    49% {
      opacity: 1;
    }
    80%,
    100% {
      opacity: 0;
    }
  }
</style>
