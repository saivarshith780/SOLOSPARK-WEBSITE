---
import { nav } from '../config/site';
import Logo from './Logo.astro';
import BookButton from './BookButton.astro';
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
---
<header class="site-header sticky top-0 z-40">
  <div class="header-bar">
    <div class="page-x flex h-(--header-h) items-center justify-between gap-4">
      <a href="/" class="brand -m-2 rounded-pill p-2" aria-label="Solo Spark home">
        <Logo tone="light" class="h-7 w-auto md:h-[1.85rem]" />
      </a>

      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link rounded-pill px-3.5 py-2 font-display text-[1.0125rem] font-semibold"
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="ml-3"><BookButton variant="light" class="btn-sm" /></li>
        </ul>
      </nav>

      <button
        type="button"
        class="menu-btn inline-flex h-11 w-11 items-center justify-center rounded-pill md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
          <path class="bar bar-top" d="M4 12h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          <path class="bar bar-bottom" d="M4 12h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="mobile-menu glass md:hidden" hidden>
    <ul class="page-x flex flex-col py-5">
      {nav.map((item, i) => (
        <li class="mobile-item" style={`--i:${i}`}>
          <a
            href={item.href}
            class="nav-link block rounded-tile py-3 font-display text-step-2 font-bold"
            aria-current={path === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mobile-item pt-5" style={`--i:${nav.length}`}><BookButton class="w-full" /></li>
    </ul>
  </nav>
</header>

<style>
  /* Frosted by default; clear while the page sits at the very top (set by the script below) */
  .header-bar {
    background: rgb(5 8 26 / 0.62);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    box-shadow:
      0 1px 0 var(--color-line),
      0 18px 40px -30px rgb(0 0 0 / 0.9);
    transition:
      background-color 400ms var(--ease-out-quart),
      box-shadow 400ms var(--ease-out-quart),
      backdrop-filter 400ms var(--ease-out-quart);
  }
  :global(.js) .site-header:not([data-scrolled]):not(:has([aria-expanded='true'])) .header-bar {
    background: rgb(5 8 26 / 0);
    -webkit-backdrop-filter: blur(0) saturate(100%);
    backdrop-filter: blur(0) saturate(100%);
    box-shadow:
      0 1px 0 transparent,
      0 18px 40px -30px transparent;
  }

  /* The spark in the logo turns a quarter (it looks the same either way) on hover */
  .brand :global(.logo-spark) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 700ms var(--ease-out-expo);
  }
  .brand:hover :global(.logo-spark) {
    transform: rotate(90deg) scale(1.1);
  }

  .nav-link {
    position: relative;
    color: var(--color-mist);
    text-decoration: none;
    transition:
      color 200ms,
      background-color 250ms;
  }
  .nav-link:hover {
    color: var(--color-snow);
    background: rgb(255 255 255 / 0.06);
  }
  .nav-link[aria-current='page'] {
    color: var(--color-snow);
  }
  /* The current page gets a small line of spark light under it */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 1.1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-spark);
    box-shadow: 0 0 10px rgb(255 201 51 / 0.9);
    translate: -50% 0;
    scale: 0 1;
    transition: scale 350ms var(--ease-out-expo);
  }
  .nav-link[aria-current='page']::after {
    scale: 1 1;
  }
  .mobile-menu .nav-link {
    color: var(--color-snow);
    padding-inline: 0.75rem;
    margin-inline: -0.75rem;
  }
  .mobile-menu .nav-link::after {
    left: 0.75rem;
    bottom: 0.6rem;
    width: 2rem;
    translate: none;
    transform-origin: left;
  }

  .menu-btn {
    color: var(--color-snow);
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  /* Two bars that fold into an X */
  .bar {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      translate 350ms var(--ease-out-expo),
      rotate 350ms var(--ease-out-expo);
  }
  .bar-top {
    translate: 0 -4px;
  }
  .bar-bottom {
    translate: 0 4px;
  }
  .menu-btn[aria-expanded='true'] .bar-top {
    translate: 0 0;
    rotate: 45deg;
  }
  .menu-btn[aria-expanded='true'] .bar-bottom {
    translate: 0 0;
    rotate: -45deg;
  }

  /* Mobile menu: a glass sheet under the bar. Fades in and out where supported. */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    /* Landscape phones and zoomed-in views: the menu scrolls instead of being cut off */
    max-height: calc(100vh - var(--header-h));
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: rgb(5 8 26 / 0.86);
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
    transition:
      opacity 300ms var(--ease-out-quart),
      translate 300ms var(--ease-out-expo),
      display 300ms allow-discrete;
  }
  .mobile-menu[hidden] {
    opacity: 0;
    translate: 0 -8px;
  }
  @starting-style {
    .mobile-menu:not([hidden]) {
      opacity: 0;
      translate: 0 -8px;
    }
  }
  .mobile-item {
    transition:
      opacity 400ms var(--ease-out-quart),
      translate 500ms var(--ease-out-expo);
    transition-delay: calc(var(--i) * 40ms + 60ms);
  }
  @starting-style {
    .mobile-menu:not([hidden]) .mobile-item {
      opacity: 0;
      translate: 0 10px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');

  // Header turns to frosted glass once the page scrolls.
  if (header) {
    let queued = false;
    const update = () => {
      queued = false;
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
