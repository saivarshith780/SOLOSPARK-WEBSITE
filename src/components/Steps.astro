---
import { steps } from '../config/site';
---
<ol class="steps relative grid gap-10 lg:grid-cols-4 lg:gap-8">
  {steps.map((step, i) => (
    <li class="step relative pl-16 lg:pl-0 lg:pt-16">
      <span class="step-num absolute top-0 left-0 inline-flex h-11 w-11 items-center justify-center rounded-full border-2 border-ink bg-paper font-display text-step-1 font-bold">
        {i + 1}
      </span>
      <h3 class="type-card">{step.title}</h3>
      <p class="mt-2 text-slate">{step.body}</p>
    </li>
  ))}
</ol>

<style>
  /* The "wire" connecting each step */
  .steps::before {
    content: '';
    position: absolute;
    left: 21px;
    top: 22px;
    bottom: 22px;
    width: 2px;
    background: var(--color-line);
  }
  @media (min-width: 64rem) {
    .steps::before {
      left: 22px;
      right: 0;
      top: 21px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
  .step:first-child .step-num {
    background: var(--color-spark);
    border-color: var(--color-spark);
  }
</style>
