---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---
<section class="page-hero relative">
  <div class="page-x pt-16 pb-16 md:pt-24 md:pb-24">
    <h1 class="type-display text-lit load-in max-w-[16ch]">{title}</h1>
    {lede && <p class="lede load-in mt-7" style="--d:120ms">{lede}</p>}
    <div class="load-in" style="--d:220ms"><slot /></div>
  </div>
</section>
