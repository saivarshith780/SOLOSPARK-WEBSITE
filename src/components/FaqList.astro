---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="divide-y divide-line border-y border-line">
  {items.map((item) => (
    <details class="faq group">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-step-1 font-semibold">
        <span>{item.q}</span>
        <span class="faq-icon mt-1 inline-flex h-7 w-7 flex-none items-center justify-center rounded-full border-2 border-ink" aria-hidden="true">
          <svg viewBox="0 0 12 12" class="h-3 w-3"><path d="M1 6h10M6 1v10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </span>
      </summary>
      <p class="max-w-[38rem] pb-6 text-slate">{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon path {
    transition: transform 200ms var(--ease-out-quart);
    transform-origin: center;
  }
  .faq[open] .faq-icon {
    background: var(--color-spark);
    border-color: var(--color-spark);
  }
  .faq[open] .faq-icon path {
    transform: rotate(45deg);
  }
</style>
