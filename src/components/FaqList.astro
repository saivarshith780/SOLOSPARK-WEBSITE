---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---
<div class="faq-list panel px-5 sm:px-8">
  {items.map((item) => (
    <details class="faq">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-step-1 font-semibold">
        <span>{item.q}</span>
        <span class="faq-icon mt-0.5 inline-flex h-8 w-8 flex-none items-center justify-center rounded-full" aria-hidden="true">
          <svg viewBox="0 0 12 12" class="h-3 w-3"><path d="M1 6h10M6 1v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </span>
      </summary>
      <div class="faq-body">
        <p class="max-w-[38rem] pb-6 text-mist">{item.a}</p>
      </div>
    </details>
  ))}
</div>

<style>
  .faq + .faq {
    border-top: 1px solid var(--color-line);
  }
  .faq summary {
    color: var(--color-snow);
    transition: color 200ms;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover {
    color: #ffffff;
  }
  .faq-icon {
    color: var(--color-mist);
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    transition:
      background-color 300ms,
      color 300ms,
      box-shadow 300ms,
      transform 500ms var(--ease-out-expo);
  }
  .faq summary:hover .faq-icon {
    color: var(--color-snow);
    box-shadow:
      inset 0 0 0 1px rgb(180 190 230 / 0.45),
      0 0 18px -4px rgb(58 91 255 / 0.7);
  }
  .faq[open] .faq-icon {
    color: var(--color-night);
    background: var(--color-spark);
    box-shadow:
      inset 0 0 0 1px var(--color-spark),
      0 0 22px -2px rgb(255 201 51 / 0.6);
    transform: rotate(45deg);
  }

  /* Smooth open and close where the browser supports animating <details> */
  @media (prefers-reduced-motion: no-preference) {
    .faq::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 450ms var(--ease-out-expo),
        content-visibility 450ms allow-discrete;
    }
    .faq[open]::details-content {
      block-size: auto;
    }
    .faq-body {
      transition:
        opacity 450ms var(--ease-out-quart),
        translate 450ms var(--ease-out-expo);
    }
    .faq:not([open]) .faq-body {
      opacity: 0;
      translate: 0 -6px;
    }
  }
</style>
