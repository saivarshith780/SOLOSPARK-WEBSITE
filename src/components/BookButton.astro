---
import { bookingHref, bookingIsExternal, site } from '../config/site';
interface Props {
  /** spark: the primary call to action. light: solid secondary. ghost: glass outline. */
  variant?: 'spark' | 'light' | 'ghost';
  class?: string;
  label?: string;
}
const { variant = 'spark', class: className = '', label = site.call.label } = Astro.props;
const external = bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {};
---
<a href={bookingHref} class:list={['btn', `btn-${variant}`, className]} {...external}>
  {label}
  {bookingIsExternal && <span class="sr-only">(opens in a new tab)</span>}
</a>
