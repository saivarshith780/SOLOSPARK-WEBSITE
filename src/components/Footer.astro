---
import { site, nav } from '../config/site';
import Logo from './Logo.astro';
import EmailLink from './EmailLink.astro';
const year = new Date().getFullYear();
const socials = [
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'GitHub', href: site.social.github },
].filter((s) => s.href);
---
<footer class="on-dark bg-cobalt-deep text-white">
  <div class="page-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.3fr_0.7fr_1.4fr]">
    <div class="sm:col-span-2 lg:col-span-1">
      <Logo tone="light" class="h-8 w-auto" />
      <p class="mt-4 max-w-sm text-mist">
        AI agents and automations, built by {site.founder.name}.
        Based in {site.location.city}, {site.location.region}. Working with clients across the US.
      </p>
    </div>
    <div>
      <h2 class="font-display text-step-1">Pages</h2>
      <ul class="mt-3 space-y-2">
        {nav.map((item) => <li><a class="link" href={item.href}>{item.label}</a></li>)}
        <li><a class="link" href="/privacy">Privacy policy</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-display text-step-1">Get in touch</h2>
      <ul class="mt-3 space-y-2">
        <li><EmailLink /></li>
        <li><a class="link" href={site.contact.phoneHref}>{site.contact.phone}</a></li>
        {socials.map((s) => <li><a class="link" href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="page-x py-5 text-step--1 text-mist">© {year} {site.legalName}. All rights reserved.</p>
  </div>
</footer>
