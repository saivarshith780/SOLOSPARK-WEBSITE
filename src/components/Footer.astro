---
import { site, nav } from '../config/site';
import Logo from './Logo.astro';
import EmailLink from './EmailLink.astro';
const year = new Date().getFullYear();
const socials = [
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'GitHub', href: site.social.github },
].filter((s) => s.href);
---
<footer class="seam relative overflow-hidden bg-night-1/70">
  <div class="glow glow-deep absolute -top-64 left-1/2 h-[30rem] w-[min(70rem,140vw)] -translate-x-1/2 opacity-70" aria-hidden="true"></div>

  <div class="page-x relative grid gap-12 py-16 sm:grid-cols-2 md:py-20 lg:grid-cols-[1.3fr_0.7fr_1.4fr]">
    <div class="sm:col-span-2 lg:col-span-1">
      <Logo tone="light" class="h-8 w-auto" />
      <p class="mt-5 max-w-sm text-mist">
        AI agents and automations, built by {site.founder.name}.
        Based in {site.location.city}, {site.location.region}. Working with clients across the US.
      </p>
    </div>
    <div>
      <h2 class="font-display text-step-0 font-semibold text-snow">Pages</h2>
      <ul class="mt-4 space-y-2.5">
        {nav.map((item) => <li><a class="link-quiet" href={item.href}>{item.label}</a></li>)}
        <li><a class="link-quiet" href="/privacy">Privacy policy</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-display text-step-0 font-semibold text-snow">Get in touch</h2>
      <ul class="mt-4 space-y-2.5">
        <li><EmailLink quiet /></li>
        <li><a class="link-quiet" href={site.contact.phoneHref}>{site.contact.phone}</a></li>
        {socials.map((s) => <li><a class="link-quiet" href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="relative border-t border-line">
    <p class="page-x py-6 text-step--1 text-haze">© {year} {site.legalName}. All rights reserved.</p>
  </div>
</footer>
