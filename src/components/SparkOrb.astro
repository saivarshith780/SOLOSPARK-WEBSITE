---
// The spark mark set in a sphere of cobalt light. Used for the founder on the
// home page, the headshot placeholder on About, and the 404 page.
// Anything passed in the slot sits under the spark.
import Spark from './Spark.astro';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class:list={['orb relative isolate flex flex-col items-center justify-center gap-3 rounded-full text-center', className]}>
  <span class="orb-halo breathe" aria-hidden="true"></span>
  <Spark class="orb-spark" />
  <slot />
</div>

<style>
  .orb {
    background: radial-gradient(circle at 50% 32%, #4865ff 0%, var(--color-cobalt) 36%, #0f1d74 68%, #0a1240 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.4),
      inset 0 -24px 48px rgb(5 8 26 / 0.55),
      0 0 0 1px rgb(142 162 255 / 0.3),
      0 30px 80px -24px rgb(58 91 255 / 0.65);
  }
  .orb-halo {
    position: absolute;
    inset: -35%;
    z-index: -1;
    border-radius: 9999px;
    background: radial-gradient(closest-side, rgb(58 91 255 / 0.4), rgb(58 91 255 / 0.12) 55%, transparent 75%);
    pointer-events: none;
  }
  .orb :global(.orb-spark) {
    width: 40%;
    height: 40%;
    filter: drop-shadow(0 0 10px rgb(255 201 51 / 0.75)) drop-shadow(0 0 28px rgb(255 201 51 / 0.4));
  }
</style>
